# Copy this file to .env at the repository root.
# Local Supabase values are printed by `npx supabase start` / `npx supabase status`.
# NEVER put the service_role key here - this file is bundled into the web client.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
